APP_ENV=local

GATEWAY_HTTP_ADDR=:8080
GATEWAY_SHUTDOWN_TIMEOUT=10s
LEDGER_GRPC_HOST=localhost
LEDGER_GRPC_DIAL_TIMEOUT=5s

POSTGRES_DB=finance
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379

LEDGER_DATABASE_URL=postgres://finance:finance@localhost:5432/finance?sslmode=disable
LEDGER_GRPC_PORT=9090
LEDGER_SHUTDOWN_TIMEOUT=10s
LEDGER_SUMMARY_CACHE_TTL=5m

AUTH_DATABASE_URL=postgres://finance:finance@localhost:5432/finance?sslmode=disable
AUTH_GRPC_PORT=9091
AUTH_SHUTDOWN_TIMEOUT=10s
AUTH_BCRYPT_COST=12
AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes
AUTH_JWT_ISSUER=personal-finance-analytics/auth
AUTH_JWT_ACCESS_TTL=15m
